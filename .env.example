# Copy this file to .env and adjust values. The real .env is never committed.

# Postgres (used by docker-compose)
POSTGRES_USER=discovery
POSTGRES_PASSWORD=discovery
POSTGRES_DB=ai_discovery

# Application database connection
DATABASE_URL=postgresql+psycopg://discovery:discovery@localhost:5432/ai_discovery

# Cloud scanning mode: "mock" uses moto and fixtures, "live" uses real credentials
SCAN_MODE=mock
# LLM provider (Groq). Get a free key at console.groq.com
GROQ_API_KEY=
SMALL_MODEL_NAME=openai/gpt-oss-20b
LARGE_MODEL_NAME=openai/gpt-oss-120b